# Public site address (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-side only). Leave blank to use the local JSON store in development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login for /admin (choose a long passphrase) and a random string for signing the session cookie
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional: send a welcome email to new subscribers and email yourself contact messages (Resend)
RESEND_API_KEY=
EMAIL_FROM="Not Alone at Midnight <hello@yourdomain.com>"
CONTACT_TO_EMAIL=
